# Public URL used to access Taskmanager. Use HTTPS in production.
BETTER_AUTH_URL=http://localhost:3000
APP_PORT=3000

# Docker Compose database URL. Keep the `postgres` hostname: Compose reads this
# file, so pointing it at localhost would leave the app container with no database.
# Outside Docker the `postgres` host is rewritten to localhost automatically, so
# native development works against the published port without editing this value.
DATABASE_URL=postgresql://arnotes:arnotes@postgres:5432/arnotes

# Optional. Docker generates and persists a secret when this is empty.
# Set a stable 32+ character value for production or non-Docker deployments.
BETTER_AUTH_SECRET=

# Allow new accounts. Set to false after creating your account when the instance
# should be private. Applies to every sign-in method, OAuth included: an existing
# user can still sign in with a linked provider, but nobody new gets an account.
ALLOW_SIGN_UP=true

# Optional Discord OAuth. Set all three values to enable the Discord button.
# Callback URL: ${BETTER_AUTH_URL}/api/auth/callback/discord
NUXT_PUBLIC_DISCORD_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional GitHub OAuth. Set all three values to enable the GitHub button.
# Callback URL: ${BETTER_AUTH_URL}/api/auth/callback/github
NUXT_PUBLIC_GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional Google OAuth. Set all three values to enable the Google button.
# Callback URL: ${BETTER_AUTH_URL}/api/auth/callback/google
# Google accepts plain http only for localhost; any other host needs HTTPS.
NUXT_PUBLIC_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional sign-in through your own OpenID Connect server: Authentik, Authelia,
# Keycloak, Pocket ID, Kanidm. NUXT_PUBLIC_OIDC_NAME is the button label.
# Callback URL: ${BETTER_AUTH_URL}/api/auth/oauth2/callback/oidc
NUXT_PUBLIC_OIDC_ENABLED=false
NUXT_PUBLIC_OIDC_NAME=Single sign-on
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Passkeys need no outside service and are on by default. A passkey belongs to
# the hostname in BETTER_AUTH_URL, so changing that hostname orphans them.
NUXT_PUBLIC_PASSKEYS_ENABLED=true

# Optional "Email me a code" sign-in. Needs an SMTP server; SMTP_HOST and
# SMTP_FROM are required, the rest depend on the server. SMTP_SECURE=true means
# TLS from the start (usually port 465); otherwise STARTTLS on 587 is used.
# For local development, Mailpit catches everything:
#   docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
#   SMTP_HOST=localhost SMTP_PORT=1025, then read mail at http://localhost:8025
NUXT_PUBLIC_EMAIL_CODE_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Taskmanager <taskmanager@example.com>

# Public client setting for native development. Compose derives this from the
# server setting above.
NUXT_PUBLIC_ALLOW_SIGN_UP=true
